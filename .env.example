# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Conductor — https://app.conductor.build/users/api-keys
CONDUCTOR_API_KEY=
CONDUCTOR_API_URL=https://api.conductor.build/v0

# Comma-separated Telegram user IDs allowed to use the bot. First one is owner.
ALLOWED_TELEGRAM_USER_IDS=

# The private supergroup (forum topics enabled) the bot operates in.
# Leave blank until you run /setup in the group.
TELEGRAM_CHAT_ID=

# SQLite path. On Railway this is the mounted volume.
DB_PATH=/data/ctb.db

# Defaults for the zero-tap `/new <prompt>` path
DEFAULT_AGENT=claude
DEFAULT_MODEL=opus-5-1m
DEFAULT_EFFORT=high

# Transcript content is your source code. Keep this false outside debugging.
LOG_TRANSCRIPT_CONTENT=false
LOG_LEVEL=INFO
