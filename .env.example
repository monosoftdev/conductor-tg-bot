# ── required: the bot will not boot without all four ────────────────────────
# (they are reported together, so set them in one go)

# Telegram — from @BotFather. Check it before deploying:
#   curl "https://api.telegram.org/bot<TOKEN>/getMe"
# One bot serves every workspace; customers add it to their own supergroup.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# PostgreSQL, as the `ctb_app` role. Row-level security applies to it, so a
# query with no tenant in scope returns nothing rather than everything.
DATABASE_URL=postgresql://ctb_app:...@host:5432/ctb

# PostgreSQL, as the `ctb_worker` role, which holds BYPASSRLS. Used only by the
# cross-tenant workers: supervisor reconcile, the delivery and voice claim
# loops, prune, and the tenancy lookups that decide scope in the first place.
SYSTEM_DATABASE_URL=postgresql://ctb_worker:...@host:5432/ctb

# Envelope-encryption keys for the Conductor keys customers entrust to you.
# Ordered: the first seals new writes, every entry can open. Rotate by
# prepending a new one, deploying, running `python -m ctb.rewrap`, then
# dropping the old one on the next deploy.
#   Generate one:  python -m ctb.rewrap --new-key v1
# Losing these makes every stored key unreadable. Back them up separately from
# the database — together they are the same secret.
CTB_MASTER_KEYS=v1:<base64url 32 bytes>

# ── first-time setup ────────────────────────────────────────────────────────
# Create the two roles and the schema once, with a superuser DSN:
#
#   python -m ctb.db.bootstrap \
#       --admin-dsn "postgresql://postgres:...@host:5432/ctb" \
#       --app-password "..." --worker-password "..."
#
# The application itself never applies DDL; it verifies the schema at boot and
# refuses to start if it is missing.

# ── optional ────────────────────────────────────────────────────────────────

# Only the default offered to a brand-new workspace; each one stores its own.
CONDUCTOR_API_URL=https://api.conductor.build/v0

# Telegram user ids who may run platform commands (suspend a workspace, read
# global health). Empty is fine — an unattended deployment has none. This is
# NOT an allow-list for using the bot; membership of a workspace decides that.
PLATFORM_ADMIN_IDS=

# Self-serve sign-up. Turn it off to run a closed instance; existing workspaces
# keep working either way.
REGISTRATION_OPEN=true
REGISTRATION_RATE_PER_HOUR=20

# Connection pool ceilings. The app pool serves handlers; the system pool serves
# the six background services.
DB_POOL_MAX=10
SYSTEM_DB_POOL_MAX=6

# GET /health. Without a token the full body is served to loopback only, so a
# Railway public domain gets the status summary. Set a random value if you want
# the detail (pool stats, tenant slugs, recent API calls) from outside the box.
HEALTH_TOKEN=
# Railway injects PORT; HEALTH_PORT overrides it locally. Default 8080.
HEALTH_PORT=

# Voice is the one feature whose data leaves the perimeter. This is the
# platform kill switch: a workspace can turn voice off for itself, but it can
# never turn it on when this is false. Each workspace stores its OWN speech key
# (`/voicekey`); there is deliberately no shared fallback key.
VOICE_ENABLED=false
VOICE_STT_PROVIDER=elevenlabs
VOICE_STT_MODEL=scribe_v2
VOICE_MAX_DURATION_SECONDS=180
VOICE_MAX_FILE_BYTES=20971520
VOICE_MAX_CONCURRENT=2
VOICE_LANGUAGE=auto
VOICE_WAKE_PHRASES=command,команда,slash
VOICE_COMPLETED_RETENTION_DAYS=7

# What a brand-new workspace starts with. Each one can change its own after.
DEFAULT_AGENT=claude
DEFAULT_MODEL=opus-5-1m
DEFAULT_EFFORT=high
DEFAULT_BRANCH=main

# Transcript content is your customers' source code. Keep this false.
LOG_TRANSCRIPT_CONTENT=false
LOG_LEVEL=INFO
