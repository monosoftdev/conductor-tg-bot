# ── required: the bot will not boot without all three ───────────────────────
# (they are reported together, so set them in one go)

# Telegram — from @BotFather. Check it before deploying:
#   curl "https://api.telegram.org/bot<TOKEN>/getMe"
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Conductor — https://app.conductor.build/users/api-keys
CONDUCTOR_API_KEY=

# Comma-separated Telegram user IDs allowed to use the bot. First one is owner.
# This is the real security boundary. Get your id from @userinfobot.
ALLOWED_TELEGRAM_USER_IDS=

# ── optional ────────────────────────────────────────────────────────────────

CONDUCTOR_API_URL=https://api.conductor.build/v0

# The private supergroup (forum topics enabled) the bot operates in — a second
# fence on top of the allowlist. Leave it unset at first: nothing in the bot
# prints a chat id (/setup does not write this), and a wrong value silently
# drops every group update.
TELEGRAM_CHAT_ID=

# GET /health. Without a token the full body is served to loopback only, so a
# Railway public domain gets the status summary. Set a random value if you want
# the detail (session ids, DB path, recent API calls) from outside the box.
HEALTH_TOKEN=
# Railway injects PORT; HEALTH_PORT overrides it locally. Default 8080.
HEALTH_PORT=

# Telegram voice notes and audio attachments. `prompts` transcribes ordinary
# notes but keeps spoken commands in preview; use `commands` only after testing
# your own recordings. `shadow` transcribes without executing anything.
VOICE_ENABLED=false
VOICE_STT_PROVIDER=elevenlabs
VOICE_STT_MODEL=scribe_v2
VOICE_MODE=prompts
VOICE_MAX_DURATION_SECONDS=180
VOICE_MAX_FILE_BYTES=20971520
VOICE_MAX_CONCURRENT=2
VOICE_LANGUAGE=auto
VOICE_WAKE_PHRASES=command,команда,slash
VOICE_COMPLETED_RETENTION_DAYS=7
ELEVENLABS_API_KEY=

# SQLite path. On Railway this is the mounted volume.
DB_PATH=/data/ctb.db

# Defaults for the zero-tap `/new <prompt>` path
DEFAULT_AGENT=claude
DEFAULT_MODEL=opus-5-1m
DEFAULT_EFFORT=high

# Transcript content is your source code. Keep this false outside debugging.
LOG_TRANSCRIPT_CONTENT=false
LOG_LEVEL=INFO
